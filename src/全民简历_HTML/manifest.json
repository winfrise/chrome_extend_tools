{
  "manifest_version": 3,
  "name": "简历 HTML 导出工具",
  "version": "1.0",
  "description": "点击图标将指定内容导出为干净的 HTML 文件",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "导出 HTML"
  },
  "background": {
    "service_worker": "background.js"
  }
}